CONFIG_ENV=config.env

UPLOADNAME=Proton
KERNEL_CONFIG=a14m_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
EXTRA_CMDS:CLANG=clang LD=ld.lld OBJCOPY=llvm-objcopy OBJDUMP=llvm-objdump STRIP=llvm-strip

# Clang
### DO NOT CHANGE CUSTOM CMDS
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# GCC
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# Configuration
UPLOADNAME=Proton
CONFIG_LOCALVERSION=Summertime
DISABLE-LTO=false
DISABLE_CC_WERROR=false

#KSU
USE_KERNELSU=false

#Anykernel
BUILD_NAME=a14m Kernel
BUILD_USER=Arvinpwd

# Ccache
ENABLE_CCACHE=false

# DTBO image
NEED_DTBO=false
